# port 端口号
VITE_PORT=8888

#浏览器自动打开
VITE_OPEN=true

# 本地环境
ENV='development'

# 后端请求前缀
#VITE_ADMIN_PROXY_PATH='/api'

# 代码生成服务地址 (单体架构有效)
VITE_GEN_PROXY_PATH=http://127.0.0.1:5003

#本地
# VITE_ADMIN_PROXY_PATH=http://127.0.0.1:9999
# VITE_ADMIN_SERVER=http://127.0.0.1:8888 
# VITE_API_URL=/api                                              #后端请求前缀

#内网
# VITE_ADMIN_PROXY_PATH=http://local-server/api                    #后端服务器地址                  
# VITE_ADMIN_SERVER=http://local-server                            #文件上传时
# VITE_FILE_PROXY_PATH=http://local-server/admin/sys-file/         #文件服务地址

#外网
VITE_ADMIN_PROXY_PATH=http://localhost:9999            #后端服务器地址
VITE_ADMIN_SERVER=http://localhost:9999                    #文件上传时
VITE_FILE_PROXY_PATH=http://localhost:9999/admin/sys-file/ #文件服务地址


# 智能标注算法服务地址
VITE_SMART_ANNOTATE_PROXY_PATH=http://172.18.10.61:7080